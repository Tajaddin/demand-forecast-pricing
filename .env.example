# Copy to .env. Everything but DFP_API_KEYS has a working default for local use.

# MLflow: the compose server (model registry needs a database backend; the file store cannot hold one)
MLFLOW_TRACKING_URI=http://localhost:5002
MLFLOW_PORT=5002

# API
API_PORT=8100
# Comma-separated keys required in X-API-Key on /forecast, /price/* and /model/reload. With none, those routes
# refuse every request. DFP_ALLOW_UNAUTHENTICATED=true opens them while no key is set; pass it on the command
# line for a local `make serve` and keep it out of .env: Compose reads .env, and `make up` publishes the API
# port on every interface.
DFP_API_KEYS=
DFP_RATE_LIMIT=60/minute
DFP_LOG_LEVEL=INFO
# Optional traces (Tempo or any OTLP/HTTP collector)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backtest and retrain gate
DFP_BACKTEST_FOLDS=12
DFP_BACKTEST_STEP_DAYS=14
DFP_HOLDOUT_DAYS=28
DFP_DRIFT_SHARE_THRESHOLD=0.3
DFP_PROMOTION_TOLERANCE=0.05

# Observability profile
PROMETHEUS_PORT=9103
ALERTMANAGER_PORT=9104
GRAFANA_PORT=3006
GRAFANA_ADMIN_PASSWORD=change-me
